# Frontend
frontend/node_modules/
frontend/dist/

# Backend
backend/.venv/
backend/__pycache__/
**/__pycache__/
*.pyc

# Desktop build output (PyInstaller + pywebview approach)
desktop/build/
desktop/dist/
.build-venv/

# Desktop build output (Tauri approach)
desktop-tauri/build/
desktop-tauri/dist/
src-tauri/target/
src-tauri/binaries/
src-tauri/gen/
# Generated by `tauri icon` from icons/app-icon.png — regenerated in CI,
# no need to commit the derived files (keep app-icon.png itself though).
src-tauri/icons/*.png
!src-tauri/icons/app-icon.png
src-tauri/icons/*.ico
src-tauri/icons/*.icns
src-tauri/icons/icon.png

# Logs (regenerated on every run, no reason to commit)
*.log

# OS cruft
.DS_Store
__MACOSX/
